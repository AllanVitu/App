# ============================================================================
#  Variables de DÉPLOIEMENT
#
#    cp .env.production.example .env.production
#    docker compose -f docker-compose.prod.yml --env-file .env.production \
#           up -d --build
#
#  Les variables sans valeur par défaut sont OBLIGATOIRES : docker compose
#  refuse de démarrer si elles manquent, plutôt que de tomber sur un réglage
#  de développement.
# ============================================================================

# --- Adresse publique de l'application -------------------------------------
# Sert de base aux liens envoyés par e-mail et à la liste blanche CORS.
APP_URL=https://app.example.com

# Port publié par le conteneur web (à placer derrière une terminaison TLS).
HTTP_PORT=80

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=saas_db
POSTGRES_USER=saas_user
# openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Sécurité --------------------------------------------------------------
# openssl rand -hex 32   (64 caractères ; minimum 32 imposé par l'application)
JWT_SECRET=
JWT_ISSUER=saas-api
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Strict : front et API sur la même origine (cas par défaut).
# None   : uniquement si l'API est servie depuis un autre domaine que le front.
COOKIE_SAMESITE=Strict

# --- SMTP ------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="SaaS App"
