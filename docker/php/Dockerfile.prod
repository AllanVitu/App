# ============================================================================
#  Image PHP-FPM de DÉPLOIEMENT
#
#  Différences avec l'image de développement :
#   - le code source est COPIÉ dans l'image (aucun bind mount) ;
#   - configuration php.ini durcie (erreurs masquées, OPcache figé) ;
#   - le conteneur tourne sans droits d'écriture sur le code.
# ============================================================================
FROM php:8.3-fpm-alpine

RUN set -eux; \
    apk add --no-cache postgresql-client icu-libs; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS postgresql-dev icu-dev; \
    docker-php-ext-install -j"$(nproc)" pdo pdo_pgsql opcache intl; \
    apk del .build-deps

# Le contexte de build est la racine du projet (cf. docker-compose.prod.yml) :
# les chemins sont donc relatifs à celle-ci, pas au dossier du Dockerfile.
COPY docker/php/php.prod.ini /usr/local/etc/php/conf.d/99-app.ini

WORKDIR /var/www/html

# Seuls les répertoires nécessaires à l'exécution sont embarqués : ni les
# scripts SQL d'initialisation, ni les jeux de données de démonstration.
COPY --chown=www-data:www-data back/public ./public
COPY --chown=www-data:www-data back/routes ./routes
COPY --chown=www-data:www-data back/src ./src
COPY --chown=www-data:www-data back/composer.json ./composer.json

# Le code applicatif appartient à root et n'est accessible qu'en lecture au
# processus PHP : une faille d'écriture de fichier ne peut pas se transformer
# en exécution de code persistante.
RUN chown -R root:root /var/www/html && chmod -R 0555 /var/www/html

USER www-data

EXPOSE 9000
CMD ["php-fpm", "-F"]
