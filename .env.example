# ============================================================================
#  Variables d'environnement de la stack Docker
#  Copier ce fichier en ".env" puis adapter les valeurs.
#  ⚠ Le fichier .env n'est JAMAIS versionné (cf. .gitignore).
# ============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development
APP_DEBUG=true

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=saas_db
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Jeu de données inséré à la CRÉATION de la base :
#   dev.sql  -> compte de démonstration demo@saas.local / Password123!
#   none.sql -> aucune donnée de démonstration  (À UTILISER EN DÉPLOIEMENT)
DB_SEED=dev.sql

# --- Ports exposés sur l'hôte ---------------------------------------------
API_PORT=8080
FRONT_PORT=5173
ADMINER_PORT=8081
MAILPIT_PORT=8025

# --- Sécurité / JWT (Étape 3) ---------------------------------------------
# Générer une clé : openssl rand -hex 32
JWT_SECRET=change_me_generate_a_64_char_hex_secret
JWT_ISSUER=saas-api
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=1209600     # 14 jours

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Client Vue / Vite -----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# --- E-mails (vérification d'adresse, réinitialisation de mot de passe) ----
# Base des liens insérés dans les messages envoyés.
APP_FRONTEND_URL=http://localhost:5173

# En développement : Mailpit intercepte tout (http://localhost:8025).
# En production : renseigner un vrai SMTP et MAIL_ENCRYPTION=tls.
MAIL_HOST=mailer
MAIL_PORT=1025
# Chiffrement : none ou tls (STARTTLS)
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@saas.local
MAIL_FROM_NAME="Relais"
